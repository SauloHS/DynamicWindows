#include <windows.h>

1 RT_MANIFEST "dynamicwindows.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "DynamicWindows - a native activity island for Windows\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "DynamicWindows\0"
            VALUE "OriginalFilename", "DynamicWindows.exe\0"
            VALUE "ProductName", "DynamicWindows\0"
            VALUE "ProductVersion", "0.1.0\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 DynamicWindows contributors. GPL-3.0.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
